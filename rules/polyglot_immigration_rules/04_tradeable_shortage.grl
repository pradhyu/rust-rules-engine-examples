// ============================================================================
// OPTION C TRADEABLE RULE (Written in Generic Rule Language - GRL)
// ============================================================================

rule "uk_tradeable_option_c_shortage_occupation" "Option C: Immigration Salary List Job and Salary >= £30,960" salience 400 activation-group "uk_tradeable_points" {
    /* @phase: "scoring" */
    /* @category: "tradeable_criteria" */
    when
        Applicant.JobOffer.IsOnImmigrationSalaryList == true &&
        Applicant.JobOffer.AnnualSalary >= 30960.00
    then
        Applicant.AwardPoints("tradeable_criteria", 20.0);
        Log("Tradeable Option C Selected: Shortage / Immigration Salary List Job (£30,960+) Met (+20 pts)");
}
