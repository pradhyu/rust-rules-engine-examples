// ============================================================================
// MANDATORY CRITERIA RULES (Written in Generic Rule Language - GRL)
// ============================================================================

rule "uk_sponsor_job_offer_join" "Job Offer from Licensed Sponsor" salience 1000 {
    /* @phase: "scoring" */
    /* @category: "mandatory_criteria" */
    /* @is_eligibility_gate: true */
    when
        Applicant.JobOffer.HasOffer == true &&
        Applicant.JobOffer.Sponsor.IsLicensed == true &&
        Applicant.JobOffer.Sponsor.LicenseRating == "A_rated"
    then
        Applicant.AwardPoints("mandatory_criteria", 20.0);
        Log("Mandatory Criterion Met: Valid A-rated Licensed Sponsor Job Offer (+20 pts)");
}

rule "uk_skill_level_rqf3" "Job at Appropriate Skill Level (RQF 3 or higher)" salience 950 {
    /* @phase: "scoring" */
    /* @category: "mandatory_criteria" */
    /* @is_eligibility_gate: true */
    when
        Applicant.JobOffer.RqfSkillLevel >= 3
    then
        Applicant.AwardPoints("mandatory_criteria", 20.0);
        Log("Mandatory Criterion Met: Job at RQF 3+ Skill Level (+20 pts)");
}

rule "uk_english_b1_gate" "English Language Proficiency at CEFR Level B1" salience 900 {
    /* @phase: "scoring" */
    /* @category: "mandatory_criteria" */
    /* @is_eligibility_gate: true */
    when
        Applicant.Language.CefrLevel in ["B1", "B2", "C1", "C2"]
    then
        Applicant.AwardPoints("mandatory_criteria", 10.0);
        Log("Mandatory Criterion Met: English Language at CEFR B1+ (+10 pts)");
}
