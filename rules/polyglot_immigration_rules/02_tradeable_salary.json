{
  "rules": [
    {
      "id": "uk_tradeable_option_a_salary",
      "name": "Option A: Salary >= £38,700 and Going Rate",
      "description": "General salary threshold met with occupation going rate requirement",
      "phase": "scoring",
      "category": "tradeable_criteria",
      "priority": 500,
      "activation_group": "uk_tradeable_points",
      "condition": {
        "type": "all",
        "conditions": [
          {
            "type": "compare",
            "path": "applicant.job_offer.annual_salary",
            "op": "gte",
            "value": 38700.0
          },
          {
            "type": "compare",
            "path": "applicant.job_offer.meets_occupation_going_rate",
            "op": "eq",
            "value": true
          }
        ]
      },
      "actions": [
        {
          "type": "award_points",
          "category": "tradeable_criteria",
          "formula": {
            "type": "fixed",
            "points": 20.0
          },
          "reason": "Tradeable Option A: Full Salary Threshold (£38,700+) Met (+20 pts)"
        }
      ]
    }
  ]
}
